#!/usr/bin/env bash
# Starts and ends a pecia wiki session on this machine, as the orchestrator
# would for a sandbox (docs/operations.md, "Run a session").
#
#   wiki-session start <staging|prod|pr-<n>> <workspace> <model> [--create-workspace]
#   wiki-session end
#
# Every stage is behind Cloudflare Access. The script calls it with the stage's
# orchestrator service token, from $PECIA_HOME/access-<stage>.env, which
# `task access:token` writes from the Alchemy state when it is missing. A
# preview stage also needs PECIA_URL, the URL its deploy printed. No token or
# session key is ever printed.
set -euo pipefail

repo_root="$(git -C "$(dirname "${BASH_SOURCE[0]}")" rev-parse --show-toplevel)"
tools="$repo_root/packages/sandbox-tools"
state_dir="${PECIA_HOME:-${XDG_CONFIG_HOME:-$HOME/.config}/pecia}"
session_file="$state_dir/session.env"

# The stages' own hostnames (Taskfile.yml). Sessions set up before them
# recorded the workers.dev URLs, which still serve the same Workers.
staging_url=https://staging.pecia.joesaia.trade
prod_url=https://pecia.joesaia.trade
staging_workers_dev=https://pecia-controlworker-staging-5psyjyjp2wm6ohvr.joe-9a0.workers.dev
prod_workers_dev=https://pecia-controlworker-prod-3qj2wdcevov3iq5y.joe-9a0.workers.dev

die() {
  echo "wiki-session: $*" >&2
  exit 1
}

# Sets stage, url and the orchestrator token for a stage.
use_stage() {
  stage="$1"
  case "$stage" in
    staging) url="$staging_url" ;;
    prod) url="$prod_url" ;;
    pr-[0-9]*) url="${PECIA_URL:-}" && [ -n "$url" ] || die "set PECIA_URL to the URL of preview $stage" ;;
    *) die "unknown stage '$stage': use staging, prod or pr-<n>" ;;
  esac
  local token_file="$state_dir/access-$stage.env"
  if [ ! -f "$token_file" ]; then
    (cd "$repo_root" && node_modules/.bin/task --silent access:token STAGE="$stage") >&2 ||
      die "could not read $stage's orchestrator token; it needs Cloudflare credentials (docs/operations.md, \"Access\")"
  fi
  client_id="$(sed -n 's/^PECIA_ACCESS_CLIENT_ID=//p' "$token_file")"
  client_secret="$(sed -n 's/^PECIA_ACCESS_CLIENT_SECRET=//p' "$token_file")"
  [ -n "$client_id" ] && [ -n "$client_secret" ] || die "$token_file has no token; run 'task access:token STAGE=$stage'"
}

# call METHOD PATH [JSON]: prints the response body, then its status on the last line.
# The token goes in a header file on a pipe, so it is never in curl's arguments.
call() {
  curl -sS -X "$1" -H @<(printf 'CF-Access-Client-Id: %s\nCF-Access-Client-Secret: %s\n' "$client_id" "$client_secret") \
    -H 'content-type: application/json' ${3:+--data "$3"} -w '\n%{http_code}' "$url$2"
}

start() {
  [ $# -ge 3 ] || die "usage: wiki-session start <staging|prod|pr-<n>> <workspace> <model> [--create-workspace]"
  local stage="$1" workspace="$2" model="$3" create="${4:-}"
  use_stage "$stage"
  [ ! -e "$session_file" ] || die "a session is already set up on this machine ($session_file). Run 'wiki-session end' first."

  (cd "$repo_root" && node_modules/.bin/task --silent build:tools)

  local response status
  if [ "$create" = --create-workspace ]; then
    response="$(call POST /workspaces "$(jq -nc --arg name "$workspace" '{name: $name}')")"
    status="$(tail -n1 <<<"$response")"
    [ "$status" = 200 ] || die "creating workspace '$workspace' answered $status: $(sed '$d' <<<"$response")"
  fi

  local agent="amp"
  [ -z "${AMP_THREAD_ID:-}" ] || agent="amp ${AMP_URL:-https://ampcode.com}/threads/$AMP_THREAD_ID"
  response="$(call POST "/workspaces/$workspace/sessions" "$(jq -nc --arg agent "$agent" --arg model "$model" '{agent: $agent, model: $model}')")"
  status="$(tail -n1 <<<"$response")"
  local body
  body="$(sed '$d' <<<"$response")"
  if [ "$status" = 404 ]; then
    die "workspace '$workspace' does not exist on $stage. Add --create-workspace only if the user asked for a new wiki."
  fi
  [ "$status" = 200 ] || die "creating a session answered $status: $(head -c 300 <<<"$body")"

  local session_id
  session_id="$(jq -r .sessionId <<<"$body")"
  # Inside the workspace so Amp can open the pages; .gitignore keeps the clone
  # out of this repository's git status, formatting and lint.
  local wiki_dir="$repo_root/.pecia/$session_id"
  # A session that could not be set up would otherwise wait for the idle timeout.
  if ! WIKI_URL="$url" SESSION_ID="$session_id" SESSION_KEY="$(jq -r .sessionKey <<<"$body")" \
    ACCESS_CLIENT_ID="$(jq -r .accessClientId <<<"$body")" ACCESS_CLIENT_SECRET="$(jq -r .accessClientSecret <<<"$body")" \
    FORK_REMOTE="$(jq -r .forkRemote <<<"$body")" MAIN_REMOTE="$(jq -r .mainRemote <<<"$body")" \
    WIKI_CREDENTIAL="$tools/dist/wiki-credential" WIKI_DIR="$wiki_dir" "$tools/setup.sh" >&2; then
    call DELETE "/sessions/$session_id" >/dev/null || true
    rm -f "$session_file"
    die "setup failed; session $session_id was ended"
  fi

  echo "session:   $session_id ($stage)"
  echo "wiki:      $wiki_dir"
  echo "wiki-land: $tools/dist/wiki-land"
  echo "wiki-comments: $tools/dist/wiki-comments"
}

end() {
  [ -f "$session_file" ] || die "no session is set up on this machine"
  local wiki_url session_id
  wiki_url="$(sed -n 's/^WIKI_URL=//p' "$session_file")"
  session_id="$(sed -n 's/^SESSION_ID=//p' "$session_file")"
  case "$wiki_url" in
    "$staging_url" | "$staging_workers_dev") use_stage staging ;;
    "$prod_url" | "$prod_workers_dev") use_stage prod ;;
    # A preview's own name is in its workers.dev hostname.
    *-controlworker-pr-*) PECIA_URL="$wiki_url" use_stage "$(sed -E 's|.*-controlworker-(pr-[0-9]+)-.*|\1|' <<<"$wiki_url")" ;;
    *) die "$session_file names an unknown Worker: $wiki_url" ;;
  esac

  local response status body
  response="$(call DELETE "/sessions/$session_id")"
  status="$(tail -n1 <<<"$response")"
  body="$(sed '$d' <<<"$response")"
  case "$status" in
    200) echo "session $session_id ended: $(jq -r .state <<<"$body")" ;;
    404 | 409) echo "session $session_id had already ended: $body" ;;
    *) die "ending session $session_id answered $status: $body" ;;
  esac
  rm -f "$session_file"
}

case "${1:-}" in
  start) shift && start "$@" ;;
  end) end ;;
  *) die "usage: wiki-session start <staging|prod> <workspace> <model> [--create-workspace] | wiki-session end" ;;
esac
