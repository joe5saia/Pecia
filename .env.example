# Copy to .env (gitignored) and fill in. CI reads the same names from GitHub
# Actions variables, and Amp orbs from the project's environment variables.
# docs/deploy.md, "Configure your install", explains each one.

# The Cloudflare account every deploy goes to.
CLOUDFLARE_ACCOUNT_ID=
# The account API token (docs/deploy.md, "Create the API token"). Keep it out
# of .env if you can; an exported variable works the same.
CLOUDFLARE_API_TOKEN=

# Your Zero Trust team domain, without https://.
PECIA_ACCESS_TEAM=<team>.cloudflareaccess.com
# The Access login method: its type, and its name if the account has several of that type.
PECIA_IDP_TYPE=onetimepin
PECIA_IDP_NAME=

# Each stage's hostname, in a zone on the account.
PECIA_PROD_DOMAIN=wiki.example.com
PECIA_STAGING_DOMAIN=staging.wiki.example.com

# The people who may sign in, as one line of JSON.
PECIA_PRINCIPALS=[{"id":"ada","email":"ada@example.com","workloads":[]}]
